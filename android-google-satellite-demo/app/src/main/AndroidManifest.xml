<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <application
        android:label="KODI FUSION · HARTA FIX"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <meta-data android:name="com.google.android.geo.API_KEY" android:value="${MAPS_API_KEY}" />
        <activity android:name=".KodiHomeActivity" android:exported="false" />
        <activity android:name=".KodiOsmRepairActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".SurferSixDActivity" android:exported="false" />
        <activity android:name=".GeoTraceActivity" android:exported="false" />
        <activity-alias
            android:name=".GeoTraceShortcut"
            android:targetActivity=".GeoTraceActivity"
            android:label="GeoTrace"
            android:icon="@drawable/ic_geotrace"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity android:name=".SurferPanelActivity" android:exported="false" />
        <activity android:name=".GoogleSatelliteActivity" android:exported="false" />
    </application>
</manifest>
